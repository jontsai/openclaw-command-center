        {
          "id": "doc-1682349f7848d5c4715e5d2e",
          "parentId": "doc-d80a1bc1032e5c67d3296f4f",
          "kind": "document",
          "title": "Protect the thinking time",
          "sourceRef": "memory/planning/next-quarter.md",
          "updatedAt": "2026-10-05T03:08:04.257Z",
          "excerpt": "# Protect the thinking time\n\nImportant, non-urgent work deserves reserved time.\n\nAgents can prepare options and gather evidence while the operator chooses which outcomes matter.\n",
          "truncated": false,
          "url": null
